# LearnAtHome Backend Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env.

# Flask session/JWT signing key. Generate a real random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# OpenRouter API key used for AI quiz generation, flashcard generation,
# performance chat, and the parent weekly report. Get one at
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: override the default model (openai/gpt-4o-mini)
OPENROUTER_MODEL=

# Optional: IANA timezone used for session/meeting lifecycle calculations.
# Defaults to Asia/Kolkata if unset.
APP_TIMEZONE=Asia/Kolkata

# Optional: set to 1/true to enable Flask debug mode locally.
FLASK_DEBUG=0

# Google Meet integration is configured separately via
# google_meet_credentials.json + google_meet_token.json (see
# GOOGLE_MEET_SETUP.md) rather than environment variables. Those files are
# gitignored and must never be committed.
